# Copie para .env e preencha. O .env fica fora do git.

# Instagram Graph API (Business Discovery), usado por validar_perfis e coleta_instagram
IG_USER_ID=
IG_TOKEN=
IG_API_VERSION=v27.0

# YouTube Data API v3, usado por coleta_youtube
YOUTUBE_API_KEY=

# Groq, usado pela categorização e pelo agente
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# Alternativa local para a categorização (opcional)
# OLLAMA_URL=http://localhost:11434/api/chat
# OLLAMA_MODEL=qwen3-vl:4b-instruct-q4_K_M

# Frontend (opcional)
# PORTA_FRONTEND=8000
# ABRIR_NAVEGADOR=1
# SIMULAR_LIMITE=0
